rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function productAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended'
        && (!firestore.exists(/databases/(default)/documents/accounts/$(request.auth.token.email))
          || firestore.get(/databases/(default)/documents/accounts/$(request.auth.token.email)).data.get('status', 'active') != 'suspended');
    }
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow create, update: if productAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
      allow delete: if productAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
