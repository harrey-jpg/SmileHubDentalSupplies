rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-images/{allPaths=**} {
      allow read: if true;
      // Catalog uploads are an admin task. Storage rules cannot read
      // Firestore roles, so enforce identity + upload shape here and keep
      // the upload UI admin-only; move to custom claims for strict
      // server-side role enforcement.
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
