rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended')
        && (!exists(/databases/$(database)/documents/accounts/$(request.auth.token.email))
          || get(/databases/$(database)/documents/accounts/$(request.auth.token.email)).data.get('status', 'active') != 'suspended');
    }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() { return signedIn() ? userDoc().data.role : null; }
    function isStaff() {
      return signedIn() && role() in ['admin', 'staff', 'superadmin'];
    }
    function isProductAdmin() {
      return signedIn() && role() in ['admin', 'superadmin'];
    }
    function isAdmin() { return isStaff(); }
    function isSuperAdmin() { return signedIn() && role() == 'superadmin'; }
    function manageableRole(value) {
      return isSuperAdmin() || (isProductAdmin() && value in ['customer', 'staff']);
    }
    function manageAccountCreate() { return manageableRole(requestedRole()); }
    function manageAccountUpdate() {
      return manageableRole(currentRole()) && manageableRole(requestedRole());
    }
    function safeSelfCreate() {
      return request.resource.data.get('status', 'active') == 'active'
        && !request.resource.data.keys().hasAny(['permissions', 'claims', 'disabled', 'suspended', 'isSuspended']);
    }
    function safeSelfUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status', 'permissions', 'claims', 'disabled', 'suspended', 'isSuspended'
      ]);
    }
    function validProfile(uid) {
      return own(uid)
        && request.resource.data.email == request.auth.token.email
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified is bool);
    }
    function requestedRole() {
      return request.resource.data.get('role', 'customer');
    }
    function currentRole() {
      return resource.data.get('role', 'customer');
    }
    function invitedRole() {
      let regPath = /databases/$(database)/documents/user_registrations/$(request.auth.token.email);
      // Never grant staff roles through an unverified email address.
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(regPath)
        && get(regPath).data.get('claimed', true) == false
        ? get(regPath).data.get('role', 'customer')
        : null;
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isProductAdmin();
      allow update: if isProductAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock', 'minStock', 'status', 'updatedAt'
        ]));
    }
    match /products_meta/{id} {
      allow read: if true;
      allow write: if isProductAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isProductAdmin();
    }
    match /users/{uid} {
      allow create: if (validProfile(uid) && safeSelfCreate()
        && (requestedRole() == 'customer'
          || (requestedRole() in ['admin', 'staff', 'superadmin']
            && invitedRole() == requestedRole()))) || manageAccountCreate();
      allow update: if (validProfile(uid) && requestedRole() == currentRole() && safeSelfUpdate()) || manageAccountUpdate();
      allow read: if own(uid) || isProductAdmin();
      allow delete: if manageableRole(currentRole());
      match /addresses/{addressId} {
        allow read, create, update, delete: if own(uid);
      }
    }
    match /carts/{uid} {
      allow read, create, update, delete: if own(uid);
    }
    match /wishlists/{uid} {
      allow read, create, update, delete: if own(uid);
    }
    match /notifications/{id} {
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid
        || (isStaff()
          && request.resource.data.type in ['payment_verified', 'payment_rejected']
          && request.resource.data.orderId is string
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.resource.data.userId
          && getAfter(/databases/$(database)/documents/gcash_payment_claims/$(request.resource.data.orderId)).data.status
            == (request.resource.data.type == 'payment_verified' ? 'Paid' : 'Rejected')
          && (request.resource.data.type != 'payment_verified'
            || getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentStatus == 'paid')));
      allow read, update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /returns/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'userId', 'reason', 'note', 'status', 'requestedAt', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderId is string
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'Delivered'
        && validReturnRequest(request.resource.data);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow update, delete: if isProductAdmin();
    }

    function validReturnRequest(value) {
      return value.status == 'requested'
        && value.reason is string && value.reason.size() >= 1 && value.reason.size() <= 200
        && value.get('note', '') is string && value.get('note', '').size() <= 5000
        && value.requestedAt == request.time;
    }
    function newOrderReturn() {
      return resource.data.status == 'Delivered'
        && !('returnRequest' in resource.data)
        && request.resource.data.returnRequest.keys().hasOnly(['reason', 'note', 'requestedAt', 'status'])
        && validReturnRequest(request.resource.data.returnRequest);
    }
    // Both website and mobile orders use this existing shared collection.
    match /orders/{id} {
      // This is a school/demo checkout: totals come from the client and are
      // NOT trusted for real payments. Only staff may subsequently mark Paid.
      // Both the existing website and the mobile app must initially create
      // Pending orders; this prevents forged Paid/Delivered orders for ANY method.
      allow create: if signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || userDoc().data.get('role', 'customer') == 'customer')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('paymentStatus', 'unpaid') in ['unpaid', 'pending', 'Pending']
        && request.resource.data.get('gcashPaymentStatus', 'Pending Payment')
             in ['Pending Payment', 'Not Applicable']
        && request.resource.data.get('status', '')
             in ['Pending', 'Pending Payment', 'Pending Quotation']
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && (request.resource.data.get('source', '') != 'mobile'
          || (request.resource.data.get('paymentStatus', '') == 'unpaid'
            && request.resource.data.get('gcashPaymentStatus', '')
                 in ['Pending Payment', 'Not Applicable']
            && request.resource.data.status in ['Pending', 'Pending Payment']));
      // The mobile idempotent checkout checks whether its new UUID doc exists.
      // Permit GET on missing paths, but never reveal another user's real order.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/orders/$(id))
        || resource.data.userId == request.auth.uid || isStaff());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow update: if isProductAdmin()
        || (isStaff() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['returnRequest'])
          && !(request.resource.data.status in ['Returned', 'Refunded']))
        || (signedIn()
        && resource.data.userId == request.auth.uid
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequest', 'updatedAt']) && newOrderReturn())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && resource.data.status in ['Pending', 'Pending Payment']
            && resource.data.get('paymentStatus', 'unpaid') != 'paid'
            && !exists(/databases/$(database)/documents/gcash_payment_claims/$(id))
            && request.resource.data.status == 'Cancelled')));
      allow delete: if isProductAdmin();
    }

    // Customer-submitted GCash references are claims, not confirmed payments.
    // Only an authenticated staff account can set status to Paid / Rejected.
    match /gcash_payment_claims/{orderId} {
      function orderPath() {
        return /databases/$(database)/documents/orders/$(orderId);
      }
      function isGcashOwner() {
        return signedIn() && exists(orderPath())
          && get(orderPath()).data.userId == request.auth.uid
          && get(orderPath()).data.get('paymentMethod', get(orderPath()).data.get('payment', ''))
              in ['GCash (SmileHub QR)', 'GCash']
          && get(orderPath()).data.get('paymentStatus', 'unpaid') != 'paid'
          && get(orderPath()).data.status != 'Cancelled';
      }
      function validReference() {
        return request.resource.data.reference is string
          && request.resource.data.reference.matches('^[A-Za-z0-9-]{6,40}$');
      }
      allow create: if isGcashOwner()
        && request.resource.data.keys().hasOnly(['orderId', 'userId', 'reference', 'status', 'submittedAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'For Verification'
        && validReference();
      // A customer may read their claim even before it exists, and after
      // staff mark it Paid. Staff may list the entire verification queue.
      allow get: if isStaff() || (signedIn() && exists(orderPath())
        && get(orderPath()).data.userId == request.auth.uid);
      allow list: if isStaff();
      allow update: if isStaff() || (isGcashOwner()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'Rejected'
        && request.resource.data.status == 'For Verification'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reference', 'status', 'submittedAt', 'reason'
        ])
        && request.resource.data.get('reason', '') == ''
        && validReference());
      allow delete: if isProductAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /cms/{id} {
      allow read: if true;
      allow write: if isProductAdmin();
    }
    match /accounts/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isProductAdmin());
      allow create: if (signedIn() && request.auth.token.email == email
        && (requestedRole() == 'customer'
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && requestedRole() == role()))
        && safeSelfCreate()) || manageAccountCreate();
      allow update: if manageAccountUpdate();
      allow delete: if manageableRole(currentRole());
    }
    match /user_registrations/{email} {
      // This collection contains staff invitations. Customers must NEVER
      // create one, even with their own email address.
      allow read: if signedIn() && (request.auth.token.email == email || isProductAdmin());
      allow create: if manageAccountCreate();
      // The invited recipient may CLAIM (not reset) their invitation once.
      allow update: if manageAccountUpdate()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == email
          && resource.data.get('claimed', true) == false
          && request.resource.data.claimed == true
          && request.resource.data.claimedUid == request.auth.uid
          && request.resource.data.claimedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'claimed', 'claimedUid', 'claimedAt'
          ]));
      allow delete: if manageableRole(currentRole());
    }
    match /contact_messages/{id} {
      allow create: if true
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 254
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 5000
        && (!('topic' in request.resource.data) || request.resource.data.topic.size() <= 120);
      allow read, update: if isStaff();
      allow delete: if isProductAdmin();
    }
    match /deleted_accounts/{email} {
      allow read, create, delete: if isProductAdmin();
      allow update: if isProductAdmin();
    }
    match /audit_logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.action is string
        && request.resource.data.admin is string
        && request.resource.data.action.size() >= 1 && request.resource.data.action.size() <= 1000
        && request.resource.data.admin.size() >= 1 && request.resource.data.admin.size() <= 120;
      allow update, delete: if false;
    }
  }
}
