rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && userDoc().data.role in ['admin', 'staff', 'superadmin'];
    }
    function validProfile(uid) {
      return own(uid)
        && request.resource.data.email == request.auth.token.email
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified is bool);
    }
    // The role a write would set. Defaults to 'customer' when absent.
    function requestedRole() {
      return request.resource.data.get('role', 'customer');
    }
    function currentRole() {
      return resource.data.get('role', 'customer');
    }
    // Elevated roles may only be claimed once, from an unclaimed invitation
    // document that an admin created in user_registrations with that role.
    function invitedRole() {
      let regPath = /databases/$(database)/documents/user_registrations/$(request.auth.token.email);
      return exists(regPath)
        && get(regPath).data.claimed == false
        ? get(regPath).data.get('role', 'customer')
        : null;
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /products_meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      // Create: self-registration is allowed as 'customer'. Elevated roles
      // require a matching unclaimed admin-created invitation.
      allow create: if validProfile(uid)
        && (requestedRole() == 'customer'
            || (requestedRole() in ['admin', 'staff', 'superadmin']
                && invitedRole() == requestedRole()));
      // Update: profile fields may change, but the role can NEVER be changed
      // by the owner. Without this, any user could promote themselves to
      // superadmin and satisfy isAdmin() server-side.
      allow update: if validProfile(uid) && requestedRole() == currentRole();
      allow read: if own(uid) || isAdmin();
      allow delete: if own(uid) || isAdmin();

      // Saved shipping addresses subcollection (mobile app).
      match /addresses/{addressId} {
        allow read, create, update, delete: if own(uid);
      }
    }

    match /carts/{uid} {
      allow read, create, update, delete: if own(uid);
    }
    match /wishlists/{uid} {
      allow read, create, update, delete: if own(uid);
    }
    match /notifications/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /returns/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','returnRequest','updatedAt']));
      allow delete: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /cms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /accounts/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      // New sign-ups (web or mobile) may create their own account record;
      // only admins may modify or remove records afterwards.
      allow create: if signedIn() && request.auth.token.email == email;
      allow update, delete: if isAdmin();
    }
    match /user_registrations/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow create: if signedIn() && request.auth.token.email == email;
      // The invited account may claim its own invitation, but may only touch
      // the claim fields — everything else stays admin-managed.
      allow update: if isAdmin()
        || (signedIn() && request.auth.token.email == email
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['claimed', 'claimedUid', 'claimedAt']));
      allow delete: if isAdmin();
    }
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}