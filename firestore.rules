rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return signedIn() ? userDoc().data.role : null;
    }
    function isStaff() {
      return signedIn() && role() in ['admin', 'staff', 'superadmin'];
    }
    function isProductAdmin() {
      return signedIn() && role() in ['admin', 'superadmin'];
    }
    function isAdmin() {
      return isStaff();
    }
    function validProfile(uid) {
      return own(uid)
        && request.resource.data.email == request.auth.token.email
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified is bool);
    }
    // The role a write would set. Defaults to 'customer' when absent.
    function requestedRole() {
      return request.resource.data.get('role', 'customer');
    }
    function currentRole() {
      return resource.data.get('role', 'customer');
    }
    // Elevated roles may only be claimed once, from an unclaimed invitation
    // document that an admin created in user_registrations with that role.
    function invitedRole() {
      let regPath = /databases/$(database)/documents/user_registrations/$(request.auth.token.email);
      return exists(regPath)
        && get(regPath).data.claimed == false
        ? get(regPath).data.get('role', 'customer')
        : null;
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isProductAdmin();
      // Product admins may edit anything. Staff (orders+stock role) may only
      // touch stock controls — inventory is merged into the products section.
      allow update: if isProductAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'minStock', 'status', 'updatedAt']));
    }
    match /products_meta/{id} {
      allow read: if true;
      allow write: if isProductAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isProductAdmin();
    }
    match /users/{uid} {
      // Create: self-registration is allowed as 'customer'. Elevated roles
      // require a matching unclaimed admin-created invitation. Admins may also
      // create/repair other users' docs directly (for account re-linking).
      allow create: if (validProfile(uid)
        && (requestedRole() == 'customer'
            || (requestedRole() in ['admin', 'staff', 'superadmin']
                && invitedRole() == requestedRole()))) || isProductAdmin();
      // Update: profile fields may change, but the role can NEVER be changed
      // by the owner. Product admins may update any user's profile (e.g., to repair roles).
      allow update: if (validProfile(uid) && requestedRole() == currentRole()) || isProductAdmin();
      allow read: if own(uid) || isProductAdmin();
      allow delete: if own(uid) || isProductAdmin();

      // Saved shipping addresses subcollection (mobile app).
      match /addresses/{addressId} {
        allow read, create, update, delete: if own(uid);
      }
    }

    match /carts/{uid} {
      allow read, create, update, delete: if own(uid);
    }
    match /wishlists/{uid} {
      allow read, create, update, delete: if own(uid);
    }
    match /notifications/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /returns/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      // Staff may transition any status. Owners may only request a return or
      // cancel their own pending order — not set Delivered/Shipped.
      allow update: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequest','updatedAt'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
            && resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled')));
      allow delete: if isProductAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /cms/{id} {
      allow read: if true;
      allow write: if isProductAdmin();
    }
    match /accounts/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isProductAdmin());
      // New sign-ups (web or mobile) may create their own account record;
      // product admins may create missing records too (e.g. merged user profiles).
      // Only product admins may modify or remove records afterwards.
      allow create: if signedIn()
        && (request.auth.token.email == email || isProductAdmin());
      allow update, delete: if isProductAdmin();
    }
    match /user_registrations/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isProductAdmin());
      allow create: if signedIn() && (request.auth.token.email == email || isProductAdmin());
      // The invited account may claim its own invitation, but may only touch
      // the claim fields — everything else stays admin-managed.
      allow update: if isProductAdmin()
        || (signedIn() && request.auth.token.email == email
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['claimed', 'claimedUid', 'claimedAt']));
      allow delete: if isProductAdmin();
    }
    match /contact_messages/{id} {
      allow create: if true
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 254
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 5000
        && (!('topic' in request.resource.data) || request.resource.data.topic.size() <= 120);
      allow read, update: if isStaff();
      allow delete: if isProductAdmin();
    }
    match /deleted_accounts/{email} {
      allow read, create, delete: if isProductAdmin();
      allow update: if isProductAdmin();
    }
    match /audit_logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.action is string
        && request.resource.data.admin is string
        && request.resource.data.action.size() >= 1 && request.resource.data.action.size() <= 1000
        && request.resource.data.admin.size() >= 1 && request.resource.data.admin.size() <= 120;
      allow update, delete: if false;
    }
  }
}