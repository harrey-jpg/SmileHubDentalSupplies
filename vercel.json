{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/payments/[action].js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/api/payments/:action", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
